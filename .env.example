# ==============================================================================
# VITARAK FMCG PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE ON TWO-FILE SETUP:
# 1. ".env" is used exclusively for LOCAL development and testing (localhost Postgres).
#    Seed scripts and automated test suites strictly require a localhost database.
# 2. ".env.supabase" is used exclusively for deploying/migrating to SUPABASE.
#    Never commit .env or .env.supabase. Keep .env.example with placeholders only.
# ==============================================================================

# ------------------------------------------------------------------------------
# LOCAL DATABASE CONFIGURATION (.env)
# ------------------------------------------------------------------------------
# Local PostgreSQL instance (strictly required for tests and seed scripts)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/vitarak_fmcg"
DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/vitarak_fmcg"

# ------------------------------------------------------------------------------
# SUPABASE DATABASE CONFIGURATION (.env.supabase)
# ------------------------------------------------------------------------------
# 1. Transaction Pooler URL (port 6543) for runtime queries:
# DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection URL (port 5432) for migrations:
# DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# SUPABASE API CREDENTIALS (.env.supabase)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"

# Storage Bucket Names (Free plan: ordering is website-only, zero photo storage)
SUPABASE_STORAGE_BUCKET_ORDERS="order-uploads"
SUPABASE_STORAGE_BUCKET_PRODUCTS="product-images"

# ------------------------------------------------------------------------------
# APPLICATION & BRANDING
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Suppress Next.js 14.2.35 lockfile patch bug on Windows
NEXT_IGNORE_INCORRECT_LOCKFILE="1"
NEXT_PUBLIC_APP_NAME="Vitarak Platform"
RETAILER_PORTAL_TITLE="Apni Dukaan"
DISTRIBUTOR_PORTAL_TITLE="Vitarak Portal"
ADMIN_PORTAL_TITLE="Vitarak Admin"

# Google Gemini API (Multimodal AI)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# WebAuthn / Passkey relying party domain (e.g. localhost for dev, your-domain.vercel.app for prod)
WEBAUTHN_RP_ID="localhost"

# Adapters
WHATSAPP_PROVIDER="mock"
VOICE_CALL_PROVIDER="mock"
STORAGE_PROVIDER="mock"
